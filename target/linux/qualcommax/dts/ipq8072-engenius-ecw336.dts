// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
/*
 * EnGenius ECW336 — Wi-Fi 6E (AX8400) tri-band AP, product_id 0x0123 (291)
 *
 * Board design is QCA **AP-HK01-C6**, not AP-HK07. The DTB this unit boots
 * is the one QSDK ships as fdt@hk07 (ECW336 firmware v1.8.118-12), and it is
 * an hk01-c6 derivative: compatible = "qcom,ipq8074-ap-hk01-c6",
 * "qcom,ipq8074-hk01"; only its model string was relabelled
 * "IPQ8074/AP-HK07", which is why the kernel prints AP-HK07 over UART. What
 * separates it from the sibling fdt@hk01.c6 is silicon, not wiring: it
 * carries msm-id 0x156/0x185 (IPQ8072A) where hk01.c6 lists 0x143/0x186 and
 * 0x158/0x188, and u-boot matches on that. It is also the variant whose
 * switch config matches this product — one port (switch_lan_bmp = 0x20,
 * switch_mac_mode1 = 0x0d) against hk01.c6's five (0x3e / 0xff).
 *
 * Shared with the EWS377AP v3 / ECW230v3 / EWS377-FIT, and the reason the
 * dtsi below is reused: IPQ8072A, reset button on GPIO 52, parallel NAND
 * 128k/2048 with ECC 4/512 and SMEM partitions, MDIO on GPIO 68/69, console
 * on serial@78b3000. Those are Senao/EnGenius platform traits and are
 * confirmed on this unit (UART, and /etc/factory.d/btn.cfg: BTN_GPIO="52").
 * The Ethernet front end is NOT shared — see below.
 *
 * Two hardware differences from those three, both read out of the booted
 * DTB and cross-checked against the stock rootfs:
 *
 *  1. Ethernet is a single 5 GbE port on ESS port 5 via uniphy1 in USXGMII
 *     mode behind a Marvell AQR114C clause-45 PHY at MDIO address 8 — not
 *     the QCA8081 2.5 GbE on port 6 / uniphy2 that the dual-band siblings
 *     use (those values come from EnGenius' own OEM DTS, not from any QCA
 *     RDP, so the reference-design name predicts nothing here). Cross-checked
 *     against the stock rootfs: /etc/factory.d/board.cfg says ETH="AQR114C",
 *     and the image ships aq-fw-download + an sn-ethphyfw package.
 *  2. A QCN9074 6 GHz radio on the PCIe gen3 controller (pcie@20000000,
 *     the only one enabled), PERST on GPIO 58 active-low. Stock console:
 *     "remoteproc1: QCN9000_PCI0 is available".
 *
 * Deliberately NOT inherited from the siblings' dtsi: its MDIO
 * reset-gpios = <&tlmm 43>. On this board GPIO 42/43 are muxed as blsp1_i2c,
 * and the stock DTB declares no PHY reset line at all.
 *
 * LEDs: the dtsi's gpio-leds on GPIO 54/55/56 are deleted below — those are
 * the siblings' LEDs and appear nowhere in this board's DTB. All five of this
 * board's LEDs hang off the IPQ807x LEDC block (ledc@191e000, "qti,ledc",
 * GPIO 18/19/20 = clk/data/clr), driven by kmod-leds-ipq-ledc.
 *
 * Other board pins seen in the stock DTB and not yet used: dc_det GPIO 64,
 * 802.3at class detect GPIO 66, AQR PHY interrupt GPIO 67.
 */

#include "ipq8072-engenius-ap-hk07.dtsi"

/ {
	model = "EnGenius ECW336";
	compatible = "engenius,ecw336", "qcom,ipq8074";

	/* The dtsi's gpio-leds are the siblings' LEDs, not this board's. */
	/delete-node/ leds;
};

&{/aliases} {
	led-boot = &led_pwr;
	led-failsafe = &led_pwr;
	led-running = &led_pwr;
	led-upgrade = &led_pwr;
};

&tlmm {
	ledc_pins: ledc-pins {
		led_clk {
			pins = "gpio18";
			function = "led0";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_data {
			pins = "gpio19";
			function = "led1";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_clr {
			pins = "gpio20";
			function = "led2";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

/*
 * All five LEDs hang off the IPQ807x LEDC block over a serial clk/data/clr
 * interface, not off GPIOs. Every value here is the vendor's own, read out of
 * the DTB the stock firmware boots (ledc@191e000): the twelve TCSR register
 * values, the blink indices (which are the LEDs' bit positions in CG6, in the
 * order power, lan, 2.4G, 5G, 6G) and the single LED-index/blink-source pair.
 * Pin functions led0/led1/led2 on GPIO 18/19/20 exist in mainline's
 * pinctrl-ipq8074, so the vendor's pinmux carries over unchanged.
 */
&soc {
	ledc: ledc@191e000 {
		compatible = "qti,ledc";
		reg = <0x191e000 0x20070>;
		reg-names = "ledc_base_addr";

		qti,tcsr_ledc_values = <0x320193 0x0 0x0 0x0 0x0 0xffffffff
					0xffff7fff 0xffffffff 0x7d0820 0x0
					0x10482094 0x3ffffe1>;
		qti,ledc_blink_indices_cnt = <5>;
		qti,ledc_blink_indices = <0xf 0xe 0xd 0xc 0xb>;
		qti,ledc_blink_idx_src_pair = <5 20>;

		pinctrl-0 = <&ledc_pins>;
		pinctrl-names = "default";

		/*
		 * Labels mirror the vendor's own LED names (pwr_led, lan_led,
		 * wlan_{2g,5g,6g}_led); the physical colours are not recorded
		 * anywhere in the firmware, so function/color are not claimed.
		 */
		led_pwr: led-0 {
			label = "ecw336:pwr";
		};

		led_lan: led-1 {
			label = "ecw336:lan";
		};

		led_wlan2g: led-2 {
			label = "ecw336:wlan2g";
		};

		led_wlan5g: led-3 {
			label = "ecw336:wlan5g";
		};

		led_wlan6g: led-4 {
			label = "ecw336:wlan6g";
		};
	};
};

&mdio {
	/* 42/43 are blsp1_i2c here, so the siblings' PHY reset must not fire. */
	/delete-property/ reset-gpios;
	/delete-node/ ethernet-phy@28;

	aqr114c: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
		nvmem-cells = <&aqr_fw>;
		nvmem-cell-names = "firmware";
	};
};

/* The 5 GbE port hangs off uniphy1, so the siblings' uniphy2 stays down. */
&uniphy1 {
	status = "okay";
};

&uniphy2 {
	status = "disabled";
};

&switch {
	ports {
		/delete-node/ port@6;

		swport5: port@5 {
			reg = <5>;
			label = "lan";
			phy-handle = <&aqr114c>;
			phy-mode = "usxgmii";
			managed = "in-band-status";
			pcs-handle = <&uniphy1 0>;
			nvmem-cells = <&macaddr_ubootenv_ethaddr>;
			nvmem-cell-names = "mac-address";
		};
	};
};

/*
 * The AQR114C has no on-board flash of its own: its firmware lives in the
 * 0:ETHPHYFW NAND partition (0xff80000, 512 KiB per u-boot smeminfo) behind
 * a 40-byte QCOM MBN header, and u-boot does not load it on Linux's behalf.
 * Same arrangement as the Linksys MX8500, which carries the same PHY; the
 * cell length is taken from there and fits inside this smaller partition
 * (0x28 + 0x60002 = 0x6002a < 0x80000). The .cld parser reads its own
 * lengths out of the header, so a cell longer than the blob is harmless.
 */
&qpic_nand {
	nand@0 {
		partitions {
			partition-0-ethphyfw {
				label = "0:ethphyfw";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					aqr_fw: firmware@28 {
						/* skip the 40-byte QCOM MBN header */
						reg = <0x28 0x60002>;
					};
				};
			};
		};
	};
};

&wifi {
	qcom,ath11k-calibration-variant = "EnGenius-ECW336";
};

/* 6 GHz: QCN9074 on the gen3 controller. */
&pcie_qmp0 {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* ath11k has no DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-calibration-variant = "EnGenius-ECW336";
		};
	};
};
